<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DistributedFractals.Gui.Views.RenderCompletionDialog"
        Title="Render Complete"
        Width="620"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}">

    <Border Background="{StaticResource AppBgBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1">
        <StackPanel Margin="24" Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock Text="Render complete"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource AppTextBrush}" />
                <TextBlock Text="Saved to"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextMutedBrush}" />
                <TextBox x:Name="OutputPathText"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="{StaticResource AppSurfaceBrush}"
                         Foreground="{StaticResource AppTextBrush}"
                         FontSize="12"
                         Padding="10,8"
                         ToolTip.Tip="{Binding #OutputPathText.Text}" />
            </StackPanel>

            <Grid ColumnDefinitions="*,32,*,32,*">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Total time"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}" />
                    <TextBlock Text="Total time of rendering process"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource AppTextMutedBrush}" />
                    <TextBlock x:Name="RenderTimeText"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="Avg render"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}" />
                    <TextBlock Text="Average client-side render time per batch"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource AppTextMutedBrush}" />
                    <TextBlock x:Name="AverageRenderText"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Spacing="4">
                    <TextBlock Text="Avg comm"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}" />
                    <TextBlock Text="Average communication overhead per batch"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource AppTextMutedBrush}" />
                    <TextBlock x:Name="AverageCommunicationText"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="8">
                <TextBlock Text="Per client"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}" />
                <Border BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        Background="{StaticResource AppSurfaceBrush}">
                    <ScrollViewer MaxHeight="220"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ClientRowsPanel" Margin="0,8" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <Grid ColumnDefinitions="*,8,*"
                  HorizontalAlignment="Right">
                <Button Grid.Column="0"
                        Content="Export CSV"
                        Classes="muted"
                        MinWidth="120"
                        HorizontalContentAlignment="Center"
                        Padding="20,10"
                        Click="OnExportCsvClick" />
                <Button Grid.Column="2"
                        Content="OK"
                        Classes="accent"
                        MinWidth="100"
                        HorizontalContentAlignment="Center"
                        Padding="20,10"
                        Click="OnCloseClick" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
